# DeepTrace configuration — copy to .env and adjust as needed.
#
# Every setting below is optional: DeepTrace runs with no .env file at all, using
# the defaults shown. There are no API keys or secrets anywhere in this project —
# all analysis runs locally on CPU against locally stored model weights, so there
# is nothing here that must be kept private.

# ─── Backend ─────────────────────────────────────────────────────────────────

# SQLite database file. Defaults to deeptrace.db in the repository root.
# The test suite overrides this to a throwaway file so runs never touch real data.
DEEPTRACE_DB_PATH=

# Upload ceilings in megabytes, enforced while streaming to disk. A file over the
# limit is rejected with HTTP 413 and the partial write is removed.
DEEPTRACE_MAX_UPLOAD_MB=200
DEEPTRACE_MAX_REFERENCE_MB=25

# Frames sampled per video for manipulation analysis and localization. Higher
# values give finer time resolution and take proportionally longer on CPU.
DEEPTRACE_FRAME_SAMPLES=12

# Comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 for local development.
DEEPTRACE_CORS_ORIGINS=

# Absolute path to the ffmpeg binary. Leave blank to use ffmpeg from PATH.
# Without FFmpeg, video frame extraction and audio decoding report themselves
# unavailable rather than failing the case.
FFMPEG_PATH=

# ─── Model caches ────────────────────────────────────────────────────────────
# Redirect Hugging Face / PyTorch downloads (the SpeechBrain speaker model and
# FaceNet weights) to a specific directory instead of the user profile.

HF_HOME=
TORCH_HOME=
TRANSFORMERS_CACHE=

# ─── Frontend ────────────────────────────────────────────────────────────────
# Set in frontend/.env.local, not here. Defaults to http://localhost:8000.

# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
